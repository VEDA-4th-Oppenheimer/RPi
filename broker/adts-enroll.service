# =============================================================================
#  adts-enroll.service — Qt 콘솔 인증서 발급 서비스
#  배치: sudo cp broker/adts-enroll.service /etc/systemd/system/
#        sudo systemctl daemon-reload && sudo systemctl enable --now adts-enroll
# =============================================================================
[Unit]
Description=ADTS Qt console certificate enrollment service
# 브로커가 떠 있어야 발급 직후 ACL reload 가 의미를 갖는다.
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/adts/adts_enroll

# CA 개인키(/etc/adts/certs/ca.key)를 읽고 mosquitto 를 reload 해야 하므로 root.
# CA 키는 이 장비 밖으로 나가지 않는다 — 서명은 전부 이 프로세스 안에서 이뤄진다.
User=root

Environment=ADTS_CERT_DIR=/etc/adts/certs
Environment=ADTS_TOKEN_FILE=/etc/adts/enroll_tokens
Environment=ADTS_CAMERA_FILE=/etc/adts/cameras.json
Environment=ADTS_ACL_FILE=/etc/mosquitto/conf.d/adts.acl
Environment=ADTS_GEN_CERTS=/opt/adts/gen-certs.sh
Environment=ADTS_SYSTEMCTL=/bin/systemctl
Environment=ADTS_BIND_PORT=8443
Environment=ADTS_MQTT_PORT=8883
# 비워두면 요청의 Host 헤더를 mqtt.host 로 내려준다. 클라이언트가 IP 로 접속하면
# 그 IP 가 그대로 쓰이므로 대개 그대로 두면 된다. 브로커가 다른 호스트면 지정한다.
# Environment=ADTS_MQTT_HOST=172.20.32.110

Restart=on-failure
RestartSec=5

# root 로 도는 만큼 건드릴 수 있는 범위를 좁힌다.
ProtectSystem=full
ReadWritePaths=/etc/adts /etc/mosquitto/conf.d
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
