/*
 * led-sw-overlay.dts — /dev/led_sw (LED x3 + Switch x2) Device Tree Overlay
 *
 * RPi GPIO 핀 선언:
 *   - LED_초록       : GPIO 17 (pin 11)
 *   - LED_노랑       : GPIO 27 (pin 13)
 *   - LED_빨강       : GPIO 22 (pin 15)
 *   - 스위치_scan_start: GPIO 23 (pin 16, Active Low with pull-up)
 *   - 스위치_ems      : GPIO 24 (pin 18, Active Low with pull-up)
 *
 * 빌드 및 적용:
 *   make dtbo
 *   sudo dtoverlay overlays/led-sw-overlay.dtbo
 */

/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&gpio>;
		__overlay__ {
			led_sw_pins: led_sw_pins {
				/* 17: Green, 27: Yellow, 22: Red, 23: Scan Start, 24: EMS, 26: Buzzer */
				brcm,pins = <17 27 22 23 24 26>;
				brcm,function = <1 1 1 0 0 1>; /* 1: Output, 0: Input */
				brcm,pull = <0 0 0 2 2 0>;     /* 0: None, 2: Pull-Up */
			};
		};
	};

	fragment@1 {
		target-path = "/";
		__overlay__ {
			led_sw {
				compatible = "adts,led-sw";
				status = "okay";

				pinctrl-names = "default";
				pinctrl-0 = <&led_sw_pins>;

				gpios-led-green      = <&gpio 17 0>;
				gpios-led-yellow     = <&gpio 27 0>;
				gpios-led-red        = <&gpio 22 0>;
				gpios-sw-scan-start  = <&gpio 23 1>;
				gpios-sw-ems         = <&gpio 24 1>;
				gpios-buzzer         = <&gpio 26 0>;
			};
		};
	};
};
