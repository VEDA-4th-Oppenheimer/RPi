# ============================================================================
#  camera.conf — 스캔 JSON 을 받아갈 카메라(CV5 CCTV 앱) 접속 설정
#  배치 위치: /etc/adts/camera.conf   (ADTS_CAM_CONF 로 바꿀 수 있다)
# ----------------------------------------------------------------------------
#  ★ 데몬은 **업로드를 시도할 때마다** 이 파일을 다시 읽는다.
#    IP 가 바뀌면 host 만 고치면 되고, 데몬을 재시작할 필요가 없다.
#    (재시도 3회 사이에도 다시 읽으므로, 실패하는 걸 보고 그 자리에서
#     고쳐도 그 회차 안에 반영된다)
#
#  ⚠️ 이 파일이 systemd 유닛의 Environment= 를 **이긴다.** 그래야 파일을
#    고쳤을 때 실제로 반영된다.
# ============================================================================

# ── 주소 ── host 는 바뀌는 값(DHCP). 카메라 웹UI에서 현재 IP 를 확인해 적는다.
#   port 는 수신 앱이 고정으로 여는 값이라 손댈 일이 없다.
host      = 172.20.32.43
port      = 2222

# ── 신원 ── 안 바뀌는 값. 카메라 인증서 SAN 에 들어있는 이름이다.
#
#   ★ 주소가 아니라 이 이름으로 상대를 검증한다. 그래서 IP 가 매일 바뀌어도
#     인증서를 다시 발급할 필요가 없다. DNS 에 등록돼 있을 필요도 없다 —
#     TLS 안에서만 쓰는 신원 라벨이다.
#
#   발급:  sudo bash broker/gen-certs.sh --server adts-camera
#   여기 값과 발급할 때 준 CN 이 반드시 같아야 한다.
name      = adts-camera

# ── 인증서 ── MQTT 와 같은 CA·같은 클라이언트 인증서를 쓴다.
ca        = /etc/adts/certs/ca.crt
cert      = /etc/adts/certs/daemon.crt
key       = /etc/adts/certs/daemon.key

# ── 기타 ──
#  timeout_s : 한 번의 읽기/쓰기가 멈춰 있을 수 있는 한도(초).
#              전체 전송 시간이 아니다. JSON 이 20~25MB 라 무선이면 넉넉히.
#  disable   : 1 이면 업로드를 아예 하지 않는다(스캔은 정상 동작).
timeout_s = 60
disable   = 0
